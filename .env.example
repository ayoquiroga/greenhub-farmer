# =========================================================
# GreenHubFarmer — Variables de Entorno (PLANTILLA)
#
# 1. Copiar este archivo: cp .env.example .env
# 2. Completar los valores marcados con REEMPLAZAR
# 3. NUNCA subir .env a git (ya está en .gitignore)
# =========================================================

# ── PostgreSQL: base de datos del proyecto ───────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=greenhub

# ── pgAdmin ───────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=root

# ── Airflow ───────────────────────────────────────────────
# UID del usuario en el host (Linux/Mac: ejecutar `id -u`)
# En Windows con Docker Desktop se puede dejar en 50000
AIRFLOW_UID=50000

# Clave de cifrado de Airflow — GENERAR con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=REEMPLAZAR_CON_CLAVE_GENERADA

# ── Kaggle API ────────────────────────────────────────────
# Copiar desde ~/.kaggle/kaggle.json
# { "username": "...", "key": "..." }
KAGGLE_USERNAME=REEMPLAZAR_CON_TU_USUARIO_KAGGLE
KAGGLE_KEY=REEMPLAZAR_CON_TU_API_KEY_KAGGLE

# ── GCP (Google Cloud Platform) ───────────────────────────
# Ruta al archivo JSON de la cuenta de servicio (relativa a la raíz del proyecto)
# Si solo querés correr el pipeline local, podés dejar esta variable vacía o comentada
GCP_CREDENTIALS_FILE=./gcp-credentials.json
GOOGLE_APPLICATION_CREDENTIALS=kestra-sandbox-2026-86d1525dea28.json
GCP_PROJECT_ID=kestra-sandbox-2026
GCS_BUCKET=greenhub-raw-kestra-2026
BQ_DATASET=greenhub
GCP_REGION=us-central1
